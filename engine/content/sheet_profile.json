        "compact": true,
        "band": true
      },
      {
        "id": "lifetime",
        "label": "ledger",
        "slots": ["lifetime"],
        "compact": false,
        "band": true
      }
    ],
    "overflow": {
      "label": "more",
      "band": true,
      "skip_slots": ["header", "body"]
    }
  },
