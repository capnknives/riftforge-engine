{
  "id": "room.engine",
  "label": "Engine room stamps (abstract parent)",
  "abstract": true,
  "extends": "room.common",
  "fields": {
    "gravity": {
      "type": "float",
      "required": false,
      "doc": "Gravity multiplier (default 1.0).",
      "default": 1.0
    },
    "evil_ward": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp: bars entrants the game layer classifies as malevolent (which categories count is entirely game-defined).",
      "default": false
    },
    "iron_ward": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp: bars entrants the game layer classifies as vulnerable to this ward's material (meaning is entirely game-defined).",
      "default": false
    },
    "devils_trap": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp: devil's trap (pentagram-in-circle folklore ward). Policy in engine/systems/occult_marks.py.",
      "default": false
    },
    "salt_line": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp: salt line across the threshold (folklore occult mark).",
      "default": false
    },
    "holy_water_ward": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp: holy-water blessing on the room (folklore reagent site).",
      "default": false
    },
    "god_ward": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp: a high-tier intrusion barrier is active on this room (compared against a caller-supplied intrusion power, e.g. via god_ward_strength below).",
      "default": false
    },
    "god_ward_strength": {
      "type": "float",
      "required": false,
      "doc": "Minimum intrusion power needed to cross this room's high-tier ward; the game layer defines what \"power\" means and how it is compared."
    },
    "wilderness": {
      "type": "bool",
      "required": false,
      "doc": "Wilderness encounter tick eligibility."
    },
    "bestiary_categories": {
      "type": "list",
      "required": false,
      "doc": "Bestiary spawn category tags."
    },
    "resource_capacity": {
      "type": "object",
      "required": false,
      "doc": "Per-resource meter cap map (need -> max)."
    },
    "dungeon": {
      "type": "bool",
      "required": false,
      "doc": "Dungeon encounter stamp (inherits from map when omitted)."
    },
    "no_random_spawn": {
      "type": "bool",
      "required": false,
      "doc": "Suppress random wilderness spawns."
    },
    "no_combat": {
      "type": "bool",
      "required": false,
      "doc": "Combat disabled in this room."
    },
    "dark": {
      "type": "bool",
      "required": false,
      "doc": "Dark room (needs light). Sewers default dark."
    },
    "foundry_amenity": {
      "type": "bool",
      "required": false,
      "doc": "Smelter/forge station (room_has_smelter); map JSON foundry_amenity."
    },
    "is_house": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (is_house).",
      "default": false
    },
    "is_home": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (is_home).",
      "default": false
    },
    "is_hotel_room": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (is_hotel_room).",
      "default": false
    },
    "is_cell": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (is_cell).",
      "default": false
    },
    "is_prison_cell": {
      "type": "bool",
      "required": false,
      "doc": "Federal prison cell.",
      "default": false
    },
    "is_grave": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (is_grave).",
      "default": false
    },
    "morgue": {
      "type": "bool",
      "required": false,
      "doc": "Hospital or custody intake; drawer custody/records verbs.",
      "default": false
    },
    "private_home": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (private_home).",
      "default": false
    },
    "build_lot": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (build_lot).",
      "default": false
    },
    "main_homeroom": {
      "type": "string",
      "required": false,
      "doc": "Multi-room house hub room key."
    },
    "doors": {
      "type": "list",
      "required": false,
      "doc": "Optional exit directions that are closable doors (list of dir names, or dict dir->bool). Omit to use topology heuristics.",
      "default": null
    },
    "door_keys": {
      "type": "object",
      "required": false,
      "doc": "Map exit direction to item catalog id for the key that unlocks that door.",
      "default": null
    },
    "no_door": {
      "type": "list",
      "required": false,
      "doc": "Exit directions that must NOT be treated as doors (open archway).",
      "default": null
    },
    "exit_descs": {
      "type": "object",
      "required": false,
      "doc": "Map exit direction to custom prose shown on look <dir>.",
      "default": null
    },
    "boat_ramp": {
      "type": "bool",
      "required": false,
      "doc": "Gravel boat ramp for trailer-backed launches (launch boat).",
      "default": false
    },
    "lake_underwater": {
      "type": "bool",
      "required": false,
      "doc": "Underwater lake cell (layout z=-1); pair with surface tile and dive.",
      "default": false
    },
    "no_park": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (no_park). -- municipal no-park plaza.",
      "default": false
    },
    "vehicle_berth": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (vehicle_berth). -- drive/board parking bay.",
      "default": false
    },
    "no_loiter": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (no_loiter).",
      "default": false
    },
    "robable": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (robable).",
      "default": false
    },
    "floor_sleep": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (floor_sleep).",
      "default": false
    },
    "has_bunks": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (has_bunks).",
      "default": false
    },
    "boss_room": {
      "type": "bool",
      "required": false,
      "doc": "Dungeon apex room (boss chamber).",
      "default": false
    },
    "enter_hazard": {
      "type": "string",
      "required": false,
      "doc": "Optional enter-room hazard id (e.g. finesse_unbalanced).",
      "default": null
    },
    "hospital": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (hospital).",
      "default": false
    },
    "gym": {
      "type": "bool",
      "required": false,
      "doc": "Gym hub -- boot seeds a pinned training dummy (gym_fixture).",
      "default": false
    },
    "mechanic": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (mechanic).",
      "default": false
    },
    "gas_station": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (gas_station).",
      "default": false
    },
    "town_worksite": {
      "type": "bool",
      "required": false,
      "doc": "Engine room stamp (town_worksite).",
      "default": false
    },
    "courthouse": {
      "type": "bool",
      "required": false,
      "doc": "Courthouse civic block (justice identity).",
      "default": false
    },
    "id_registry": {
      "type": "bool",
      "required": false,
      "doc": "Clerk window for ID registry / payfine.",
      "default": false
    },
    "federal_check": {
      "type": "bool",
      "required": false,
      "doc": "Federal database ID check room.",
      "default": false
    },
    "prison": {
      "type": "bool",
      "required": false,
      "doc": "Prison zone room stamp.",
      "default": false
    },
    "prison_yard": {
      "type": "bool",
      "required": false,
      "doc": "Prison yard (combat allowed).",
      "default": false
    },
    "visitation": {
      "type": "bool",
      "required": false,
      "doc": "Prison visitation room.",
      "default": false
    },
    "breakout_surface": {
      "type": "bool",
      "required": false,
      "doc": "Prison perimeter escape surface.",
      "default": false
    },
    "prison_solitary": {
      "type": "bool",
      "required": false,
      "doc": "Federal solitary cell; inmates stay put until the timer lifts.",
      "default": false
    },
    "online_terminal": {
      "type": "bool",
      "required": false,
      "doc": "Public records / cafe Wi-Fi terminal (history OSINT).",
      "default": false
    },
    "vendor_stock": {
      "type": "list",
      "required": false,
      "doc": "Settlement shop catalog item refs."
    },
    "shop_amenity": {
      "type": "string",
      "required": false,
      "doc": "Civic shop amenity type (player_shop_types.json key); auto-stocks tagged catalog SKUs."
    },
    "shop_tags": {
      "type": "list",
      "required": false,
      "doc": "Optional extra shop subscription tags for auto-stock filtering."
    },
    "vendor_stock_mode": {
      "type": "enum",
      "required": false,
      "values": [
        "merge",
        "explicit"
      ],
      "default": "merge",
      "doc": "merge = union auto-catalog with vendor_stock; explicit = authored list only."
    },
    "unmanned_vendor": {
      "type": "bool",
      "required": false,
      "doc": "Room vendor_stock stays buy/list-able without an on-duty clerk (secured self-service counter).",
      "default": false
    },
    "unmanned_vendor_label": {
      "type": "string",
      "required": false,
      "doc": "Player-facing counter name for unmanned_vendor list/buy prose (defaults to room name)."
    },
    "zoning": {
      "type": "string",
      "required": false,
      "doc": "TownForge zoning stamp (commercial, residential, …)."
    },
    "player_shop_hub": {
      "type": "bool",
      "required": false,
      "doc": "Pocket hub room with jobs[] + shop resources (TownForge spine).",
      "default": false
    },
    "homestead_owner": {
      "type": "string",
      "required": false,
      "doc": "Homestead plot owner character key."
    },
    "leisure_drip_mult": {
      "type": "float",
      "required": false,
      "doc": "Leisure need drip multiplier (e.g. sanctuary deck)."
    },
    "no_combat_flavor": {
      "type": "string",
      "required": false,
      "doc": "Custom prose when no_combat blocks fighting in this room."
    },
    "remodel_type": {
      "type": "string",
      "required": false,
      "doc": "House remodel stamp (kitchen, garage, …)."
    },
    "remodel_inbound_exit": {
      "type": "string",
      "required": false,
      "doc": "Named inbound exit for remodel shells."
    },
    "neutral_treaty": {
      "type": "bool",
      "required": false,
      "doc": "Limbo Separatio neutral ground: no_combat treaty ward; Angel/Demon teleport whitelist.",
      "default": false
    },
    "limbo_annex": {
      "type": "bool",
      "required": false,
      "doc": "Separatio party annex ambience (supers/limbo_ambience.py tick).",
      "default": false
    }
  }
}
